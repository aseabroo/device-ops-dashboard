<h2>Devices</h2>

<form method="post" action="/devices" class="panel form-grid">
  <label>Customer
    <select name="customer_id" required>
      <option value="">Select customer</option>
      {{#each customers}}
        <option value="{{customer_id}}">{{name}}</option>
      {{/each}}
    </select>
  </label>
  <label>Serial number <input name="serial_number" required></label>
  <label>Model <input name="model" required></label>
  <label>Purchased on <input name="purchased_on" type="date"></label>
  <label>Status
    <select name="status">
      <option value="active">active</option>
      <option value="maintenance">maintenance</option>
      <option value="retired">retired</option>
    </select>
  </label>
  <button type="submit">Add device</button>
</form>

<div class="table-wrap">
<table>
  <thead><tr><th>ID</th><th>Serial</th><th>Customer</th><th>Model / Date / Status</th><th>Actions</th></tr></thead>
  <tbody>
    {{#each devices}}
      <tr>
        <td>{{device_id}}</td>
        <td><code>{{serial_number}}</code></td>
        <td>{{customer_name}}</td>
        <td>
          <form method="post" action="/devices/{{device_id}}/update" class="row-form">
            <input name="model" value="{{model}}" required>
            <input name="purchased_on" type="date" value="{{purchased_on}}">
            <select name="status">
              <option value="{{status}}">{{status}}</option>
              <option value="active">active</option>
              <option value="maintenance">maintenance</option>
              <option value="retired">retired</option>
            </select>
            <button type="submit">Save</button>
          </form>
        </td>
        <td>
          <form method="post" action="/devices/{{device_id}}/delete" onsubmit="return confirm('Delete this device?')">
            <button class="danger" type="submit">Delete</button>
          </form>
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>
</div>
