<h2>Firmware Deployments</h2>

<form method="post" action="/deployments" class="panel form-grid">
  <label>Device
    <select name="device_id" required>
      <option value="">Select device</option>
      {{#each devices}}
        <option value="{{device_id}}">{{serial_number}} · {{model}}</option>
      {{/each}}
    </select>
  </label>
  <label>Firmware
    <select name="firmware_id" required>
      <option value="">Select firmware</option>
      {{#each firmware}}
        <option value="{{firmware_id}}">{{version}}</option>
      {{/each}}
    </select>
  </label>
  <button type="submit">Record deployment</button>
</form>

<div class="table-wrap">
<table>
  <thead><tr><th>Device</th><th>Model</th><th>Firmware</th><th>Installed</th><th>Action</th></tr></thead>
  <tbody>
    {{#each deployments}}
      <tr>
        <td><code>{{serial_number}}</code></td>
        <td>{{model}}</td>
        <td>{{version}}</td>
        <td>{{formatDateTime installed_at}}</td>
        <td>
          <form method="post" action="/deployments/delete">
            <input type="hidden" name="device_id" value="{{device_id}}">
            <input type="hidden" name="firmware_id" value="{{firmware_id}}">
            <button class="danger" type="submit">Remove</button>
          </form>
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>
</div>
